{
  // Base config: editor support, `npm run typecheck`, ts-jest and type-aware ESLint.
  // It never emits. Declarations come from tsconfig.build.json; JavaScript comes from Vite.
  "compilerOptions": {
    /* Language & environment: a frontend library consumed by bundlers and modern browsers.
       NodeNext is the strictest resolution mode: code that passes here also works in bundlers, and it forces
       explicit `.js` extensions on relative imports so the emitted .d.ts files resolve for every consumer. */
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowJs": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["jest"],

    /* Type safety */
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,

    "noEmit": true
  },
  "include": ["src", "test", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
